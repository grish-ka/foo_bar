<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <Package Name="foo_bar"
             Manufacturer="Grishka"
             Version="0.1.0.5"
             UpgradeCode="{A7831649-4322-4113-8884-635670732454}"
             Compressed="true"
             Scope="perUser">

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="true" />

        <WixVariable Id="WixUIBannerBmp" Value="app/banner.bmp" />
        <WixVariable Id="WixUIDialogBmp" Value="app/dialog.bmp" />
        <WixVariable Id="WixUILicenseRtf" Value="app/License.rtf" />

        <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="INSTALLFOLDER" Name="foo_bar">
                <Directory Id="InternalFolder" Name="_internal" />
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="foo_bar"/>
        </StandardDirectory>

        <Feature Id="Main">
            <ComponentRef Id="MainExecutable" />
            <ComponentRef Id="ApplicationShortcut" />
            <ComponentRef Id="Cleanup_InstallFolder" />
            <ComponentGroupRef Id="InternalFiles_ComponentGroup" />
        </Feature>

        <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="{9B60152F-9311-4886-9040-527263300642}">
            <File Id="foo_bar.exe" Source="app/foo_bar.exe" />
            <Environment Id="PATH" Name="Path" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="no" />
            <RegistryValue Root="HKCU" Key="Software\Grishka\foo_bar" Name="MainExecutable" Type="string" Value="1" KeyPath="yes" />
        </Component>

        <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="{E4215082-9653-4809-BC99-281986470553}">
            <Shortcut Id="ApplicationStartMenuShortcut"
                      Name="foo_bar"
                      Description="Launch foo_bar"
                      Target="[INSTALLFOLDER]foo_bar.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\Grishka\foo_bar" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
        </Component>

        <Component Id="Cleanup_InstallFolder" Directory="INSTALLFOLDER" Guid="{D1289520-2134-4091-B102-308107931661}">
            <RemoveFolder Id="INSTALLFOLDER" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\Grishka\foo_bar" Name="Path" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </Component>

    </Package>
</Wix>